{
  "name": "@chronicle/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ChronicleAnchor smart contract — deploys to Polygon Amoy via Hardhat v3 + Ignition",
  "scripts": {
    "compile": "hardhat compile",
    "deploy": "hardhat ignition deploy ./ignition/modules/ChronicleAnchor.ts --network sepolia",
